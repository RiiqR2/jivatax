{
  "name": "jivatax",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"pnpm --filter @jivatax/api dev\" \"pnpm --filter @jivatax/web dev\"",
    "dev:api": "pnpm --filter @jivatax/api dev",
    "dev:web": "pnpm --filter @jivatax/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v --remove-orphans && docker compose up -d",
    "db:show": "pnpm --filter @jivatax/api migration:show",
    "db:run": "pnpm --filter @jivatax/api migration:run",
    "db:revert": "pnpm --filter @jivatax/api migration:revert",
    "db:generate": "pnpm --filter @jivatax/api migration:generate",
    "db:create": "pnpm --filter @jivatax/api migration:create"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  }
}

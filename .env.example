NODE_ENV=development

WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Public configuration embedded in the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=52428800

API_PORT=3001

# Server-side sessions (generate SESSION_SECRET with at least 32 random bytes)
SESSION_SECRET=
SESSION_COOKIE_NAME=jivatax.sid
SESSION_TTL_SECONDS=28800
SESSION_SECURE=false
SESSION_SAME_SITE=lax
TRUST_PROXY=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=60000

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=jivatax
DATABASE_USER=jivatax
DATABASE_PASSWORD=jivatax
DATABASE_LOGGING=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jivatax
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_FORCE_PATH_STYLE=true

# Signed file transfers (values below are development placeholders, not production secrets)
S3_SIGNED_URL_EXPIRES_IN=900
FILE_MAX_SIZE_BYTES=52428800

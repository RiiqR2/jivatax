NODE_ENV=development

WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Public configuration embedded in the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=52428800

API_PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=jivatax
DATABASE_USER=jivatax
DATABASE_PASSWORD=jivatax
DATABASE_LOGGING=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jivatax
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_FORCE_PATH_STYLE=true

# Signed file transfers (values below are development placeholders, not production secrets)
S3_SIGNED_URL_EXPIRES_IN=900
FILE_MAX_SIZE_BYTES=52428800

# Authentication: generate two independent values of at least 32 random bytes.
# These placeholders are documentation only and must never be used in production.
JWT_ACCESS_SECRET=set-a-random-access-secret-of-at-least-32-bytes
JWT_REFRESH_SECRET=set-a-different-random-refresh-secret-32-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ACCESS_COOKIE_NAME=jivatax.access
REFRESH_COOKIE_NAME=jivatax.refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Set explicitly only when the API is behind a trusted reverse proxy.
TRUST_PROXY=
# Deprecated: never use NEXT_PUBLIC_ORGANIZATION_ID as an authorization source.
